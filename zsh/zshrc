        return 1
    fi
    
    local TARGET_IP="$1"
    local TARGET_DEVICE="$TARGET_IP:5555"
    
    echo "🌐 Trazando ruta a $TARGET_IP..."
    adb connect "$TARGET_DEVICE"
    sleep 1
    
    echo "⚡ Iniciando SecDesk Protocol Oculto (H.265 + 16M + Vulkan)..."
    # Añadimos -s "$TARGET_DEVICE" para apuntar exclusivamente a la tablet
    adb -s "$TARGET_DEVICE" shell am kill-all
    adb -s "$TARGET_DEVICE" shell settings put system screen_brightness_mode 0
    adb -s "$TARGET_DEVICE" shell settings put system screen_brightness 0
    
    (
        env SDL_VIDEODRIVER=wayland SDL_RENDER_DRIVER=vulkan scrcpy \
            -s "$TARGET_DEVICE" \
            --stay-awake \
            --new-display=1920x1080 \
            --video-codec=h265 \
            --video-bit-rate 16M \
            --max-fps 85 \
            --audio-codec=opus \
            --audio-bit-rate 128K \
            --audio-buffer=50 \
