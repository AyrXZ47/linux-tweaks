estabilizar_clips() {
    mkdir -p listos_para_editar
    for f in *.mp4(N); do
        if [[ ! -f "listos_para_editar/$f" ]]; then
            echo "🔥 Estabilizando frames a CFR (4K nativo) para: $f"
            # Se eliminó el filtro -vf scale. Ahora procesa el video tal cual entra, solo ajustando los fps.
            ffmpeg -i "$f" -threads 0 -c:v libx264 -preset slow -crf 17 -fps_mode cfr -r 30 -c:a copy "listos_para_editar/$f"
        else
            echo "⏭️ Saltando: $f (Ya estabilizado en el sistema)"
        fi
    done
}

estabilizar_clips_gpu() {
    mkdir -p listos_para_editar
    for f in *.mp4(N); do
        if [[ ! -f "listos_para_editar/$f" ]]; then
            echo "🚀 Acelerador a fondo: Estabilizando CFR por GPU para -> $f"
            
            ffmpeg -vaapi_device /dev/dri/renderD128 -i "$f" -vf "format=nv12,hwupload" -c:v h264_vaapi -qp 18 -fps_mode cfr -r 30 -c:a copy "listos_para_editar/$f"
            
        else
            echo "⏭️ Saltando: $f (Ya estabilizado en el sistema)"
        fi
    done
}


# Función de actualización nativa para Obsidian
update-obsidian() {
  if [ -z "$1" ]; then
    echo "Error: Debes proporcionar la versión. Ejemplo: update-obsidian 1.13.0"
    return 1
  fi
  
  local VERSION=$1
  echo "Iniciando protocolo de actualización a Obsidian v$VERSION..."
  
  cd ~/obsidian-rpm-fedora || return
  wget "https://github.com/obsidianmd/obsidian-releases/releases/download/v${VERSION}/obsidian-${VERSION}.tar.gz" -O ~/rpmbuild/SOURCES/Obsidian-${VERSION}.tar.gz
  
  # Actualizar la receta .spec sobre la marcha
  sed -i "s/^Version:.*/Version:        $VERSION/" obsidian.spec
  cp obsidian.spec ~/rpmbuild/SPECS/
  
  cd ~/rpmbuild/SPECS/ || return
  rpmbuild -ba obsidian.spec
  
  sudo dnf upgrade -y ~/rpmbuild/RPMS/x86_64/obsidian-${VERSION}-*.rpm
  echo "Obsidian actualizado exitosamente a v$VERSION."
}
