# 1. Modo Espejo: Muestra exactamente tu tablet (Con Audio)
Mirror() {
    nohup sh -c '
        adb shell settings put system screen_brightness_mode 0
        adb shell settings put system screen_brightness 0
        
        scrcpy --stay-awake --video-codec=h265 --max-size 1920 --video-bit-rate 20M --max-fps 90 --fullscreen
        
        adb shell settings put system screen_brightness_mode 1
    ' > /dev/null 2>&1 & disown
}

# 2. Modo Segundo Escritorio: Gemini en el monitor, S-Pen en la tablet (Sin Audio)
SecDesk() {
    nohup sh -c '
        adb shell settings put system screen_brightness_mode 0
        adb shell settings put system screen_brightness 0
        
        scrcpy --new-display=1920x1080/200 --video-codec=h265 --video-bit-rate 20M --max-fps 90 --fullscreen --no-audio
        
        adb shell settings put system screen_brightness_mode 1
    ' > /dev/null 2>&1 & disown
}

