# SecDesk: Monitor virtual independiente (Brillo apagado)
function SecDesk() {
    echo "⚡ Iniciando SecDesk Protocol (Cable USB: 120fps + Vulkan + 50M)..."
    
    # 1. PURGA DE RED: Matamos cualquier conexión Wi-Fi zombie de ADB
    echo "🧹 Purgando conexiones inalámbricas previas..."
    adb disconnect
    
    # 2. Forzamos con -d para que SOLO use el cable físico
    adb -d shell am kill-all
    adb -d shell settings put system screen_brightness_mode 0
    adb -d shell settings put system screen_brightness 0
    
    # 3. Lo lanzamos en el fondo para liberar la terminal
    (
        env SDL_VIDEODRIVER=wayland SDL_RENDER_DRIVER=vulkan scrcpy \
            -d \
            --stay-awake \
            --new-display=1920x1080 \
            --video-codec=h265 \
            --video-bit-rate 50M \
            --max-fps 85 \
            --audio-codec=opus \
            --audio-bit-rate 128K \
            --audio-buffer=50 \
            --fullscreen > /dev/null 2>&1
        
        # Al cerrar la ventana gráfica, se restaura el brillo
        adb -d shell settings put system screen_brightness_mode 1
    ) &!
    
    echo "✅ Enlace SecDesk por CABLE establecido. Red purgada y terminal liberada."
}

