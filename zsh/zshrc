supersampling() {
    mkdir -p listos_para_editar
    for f in *.mp4(N); do
        if [[ ! -f "listos_para_editar/$f" ]]; then
            echo "🔥 Extrayendo máxima calidad visual para: $f"
            # Añadidos: -threads 0 y -fps_mode cfr
            ffmpeg -i "$f" -threads 0 -vf "scale='if(gt(iw,ih),2560,1440)':-2:flags=lanczos,format=yuv420p" -c:v libx264 -preset slow -crf 17 -fps_mode cfr -r 30 -c:a copy "listos_para_editar/$f"
        else
            echo "⏭️ Saltando: $f (Ya optimizado en el sistema)"
        fi
    done
}




