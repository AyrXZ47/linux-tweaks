# --- DEVOPS BATTLESTATION PROTOCOL ---
function dev() {
    if [[ -z "$WEZTERM_PANE" ]]; then
        echo "❌ Error: Inicialización fallida. Se requiere entorno WezTerm activo."
        return 1
    fi

    echo "Iniciando despliegue simétrico de agentes..."

    # ==========================================
    # LÍNEA DE DIVISIÓN HORIZONTAL CENTRAL
    # ==========================================
    # Partimos la pantalla en dos bloques: Superior (Nvim/Opencode) e Inferior (Agentes/Cava)
    local PANE_BOTTOM_BLOCK=$(wezterm cli split-pane --pane-id "$WEZTERM_PANE" --bottom --percent 35)

    # ==========================================
    # BLOQUE SUPERIOR (Nvim & Opencode)
    # ==========================================
    # Dividimos el bloque superior verticalmente a la mitad.
    # El panel original ($WEZTERM_PANE) se queda a la izquierda. El nuevo va a la derecha.
    local PANE_OPENCODE=$(wezterm cli split-pane --pane-id "$WEZTERM_PANE" --right --percent 40 -- zsh -ic "opencode")

    # ==========================================
    # BLOQUE INFERIOR (Pipes, Aider, Clean, Cava)
    # ==========================================
    # 1. Creamos el panel de Cava en el extremo derecho del bloque inferior.
    # Al darle 50%, ocupará exactamente el mismo ancho que tiene opencode arriba.
    local PANE_CAVA=$(wezterm cli split-pane --pane-id "$PANE_BOTTOM_BLOCK" --right --percent 50 -- zsh -ic "cava")

    # 2. En el espacio restante de la izquierda abajo, mandamos pipes-rs al extremo izquierdo.
    local PANE_PIPES=$(wezterm cli split-pane --pane-id "$PANE_BOTTOM_BLOCK" --left --percent 10 -- zsh -ic "pipes-rs")

    # 3. Lo que quedó en medio abajo es el entorno del Junior (Aider).
    # Le robamos el 30% inferior para la terminal limpia de control de Git.
    local PANE_CLEAN=$(wezterm cli split-pane --pane-id "$PANE_BOTTOM_BLOCK" --bottom --percent 30)

    # ==========================================
    # INYECCIÓN DE COMANDOS INTERACTIVOS
    # ==========================================
    # Levantamos a Aider en el centro inferior
    echo "aider\r" | wezterm cli send-text --pane-id "$PANE_BOTTOM_BLOCK"

    # Levantamos a Neovim en el extremo superior izquierdo
    echo "nvim\r" | wezterm cli send-text --pane-id "$WEZTERM_PANE"
}




function subtitular() {
    local FILE="$1"
    if [ -z "$FILE" ]; then echo "❌ Faltó el archivo"; return 1; fi

    local TEMP_WAV="${FILE%.*}_temp.wav"
    local WHISPER_DIR="$HOME/whisper.cpp"
    local BIN="$WHISPER_DIR/build/bin/whisper-cli"
    local MODEL="$WHISPER_DIR/models/ggml-large-v3-turbo.bin"
    
    # AQUÍ ESTABA EL ERROR: Usamos el nombre exacto de la v6.2.0
    local VAD_MODEL="$WHISPER_DIR/models/ggml-silero-v6.2.0.bin"

    # Verificación de seguridad para no correr si la descarga falló
    if [ ! -f "$VAD_MODEL" ]; then
        echo "💀 Error: No encuentro el modelo VAD en $VAD_MODEL"
        echo "Ejecuta el wget que te pasé arriba."
        return 1
    fi

    # 1. Limpieza de audio
    echo "🧹 Limpiando audio..."
    ffmpeg -y -v error -i "$FILE" -ar 16000 -ac 1 -c:a pcm_s16le -af "highpass=f=200,afftdn" "$TEMP_WAV"

    # 2. Transcripción
    echo "📝 Transcribiendo..."
    "$BIN" -m "$MODEL" \
           -f "$TEMP_WAV" \
           -osrt \
           -l es \
           --vad \
           -vm "$VAD_MODEL" \
           -vt 0.50 \
           --max-len 1 \
           --split-on-word

    rm "$TEMP_WAV"
    echo "✅ Listo."
}






